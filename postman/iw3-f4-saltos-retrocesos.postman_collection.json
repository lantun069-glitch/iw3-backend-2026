        "body": { "mode": "raw", "raw": "{\n  \"orderNumber\": {{orderNumberA}},\n  \"fechaCargaPrevista\": \"2026-11-05T09:00:00\",\n  \"presetKg\": 8000.000,\n  \"camion\": {\n    \"externalCode\": \"CAM-SR-{{extSuffix}}-A\",\n    \"patente\": \"SR0001A\",\n    \"capacidadKg\": 9000.000\n  },\n  \"chofer\": {\n    \"externalCode\": \"CHO-SR-{{extSuffix}}-A\",\n    \"nombre\": \"Postman\",\n    \"apellido\": \"SRA\"\n  },\n  \"cliente\": {\n    \"externalCode\": \"CLI-SR-{{extSuffix}}-A\",\n    \"razonSocial\": \"Cliente SR A\"\n  },\n  \"producto\": {\n    \"externalCode\": \"PRD-SR-{{extSuffix}}-A\",\n    \"nombre\": \"GLP\"\n  }\n}" },
