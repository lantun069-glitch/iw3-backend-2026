					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('login responde 200', function () { pm.response.to.have.status(200); });",
							"pm.collectionVariables.set('jwtToken', pm.response.text());"
						]
					}
				}
			]
		},
